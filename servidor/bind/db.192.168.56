; Zona inversa de 192.168.56.0/24
; Ubicación en el servidor: /etc/bind/db.192.168.56
$TTL 3600
@       IN  SOA ns1.lab.internal. admin.lab.internal. (
                2026110601  ; serial
                3600        ; refresh
                900         ; retry
                604800      ; expire
                300 )       ; TTL negativo
        IN  NS  ns1.lab.internal.

10      IN  PTR supabase.lab.internal.
20      IN  PTR cliente.lab.internal.
