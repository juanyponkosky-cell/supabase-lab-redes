; Zona directa del laboratorio: lab.internal
; Ubicación en el servidor: /etc/bind/db.lab.internal
$TTL 3600
@       IN  SOA ns1.lab.internal. admin.lab.internal. (
                2026110601  ; serial (AAAAMMDDnn): incrementar en cada cambio
                3600        ; refresh
                900         ; retry
                604800      ; expire
                300 )       ; TTL negativo
        IN  NS  ns1.lab.internal.

ns1       IN  A   192.168.56.10
supabase  IN  A   192.168.56.10
cliente   IN  A   192.168.56.20
