#!/usr/sbin/nft -f
#
# Firewall del servidor Supabase (laboratorio).
# Ubicación: /etc/nftables.d/supabase-lab.nft, incluido desde /etc/nftables.conf
#
# IMPORTANTE: no usar "flush ruleset". Borraría las reglas que Docker crea para
# la NAT y el reenvío de los contenedores. Este archivo sólo reemplaza su propia tabla.
#
# Por qué dos cadenas:
#  - "entrada" (hook input) filtra lo que va al propio host: SSH y DNS (BIND9 nativo).
#  - "hacia_contenedores" (hook forward) filtra los puertos publicados por Docker.
#    Docker los publica con DNAT en prerouting, así que esos paquetes NO pasan por
#    input sino por forward. Con prioridad filter - 1 se evalúa antes que las reglas
#    de Docker (es el reemplazo de la cadena DOCKER-USER en nftables).
#    Como el DNAT ya ocurrió, el puerto original se lee con "ct original proto-dst".

define IF_LAB = "enp0s8"        # verificar con: ip a
define IF_NAT = "enp0s3"

table inet lab_filtro
delete table inet lab_filtro

table inet lab_filtro {

    set red_lab {
        type ipv4_addr
        flags interval
        elements = { 192.168.56.0/24 }
    }

    set admin_db {
        type ipv4_addr
        elements = { 192.168.56.20 }
    }

    chain entrada {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept
        meta l4proto { icmp, ipv6-icmp } accept

        # DHCP en la interfaz NAT de VirtualBox
        iifname $IF_NAT udp dport 68 accept

        ip saddr @red_lab tcp dport 22 accept
        ip saddr @red_lab meta l4proto { tcp, udp } th dport 53 accept

        limit rate 5/minute log prefix "nft-entrada-drop: "
        counter
    }

    chain hacia_contenedores {
        type filter hook forward priority filter - 1; policy accept;

        # Sólo se filtra lo que entra desde fuera del host hacia un puerto publicado
        iifname != { $IF_LAB, $IF_NAT } accept
        ct state established,related accept

        # Pooler de Postgres (5432 sesión, 6543 transacción): sólo el equipo de administración
        meta l4proto tcp ct original proto-dst { 5432, 6543 } ip saddr @admin_db counter accept

        # APIs y Studio (80 y 443 con Caddy, 8000 en la fase 1): toda la red del laboratorio
        meta l4proto tcp ct original proto-dst { 80, 443, 8000 } ip saddr @red_lab counter accept

        # Todo lo demás que fue redirigido por Docker se descarta: otros orígenes,
        # HTTP/3 (443/udp) y cualquier puerto publicado por error
        ct status dnat counter log prefix "nft-dnat-drop: " drop
    }
}
