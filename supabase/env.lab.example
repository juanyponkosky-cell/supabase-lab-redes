# Cambios del laboratorio sobre el .env que generan setup.sh / generate-keys.sh.
# Este archivo NO contiene secretos: los secretos se generan en el servidor
# y el .env real nunca se sube al repositorio.

# --- URLs, fase 1 (HTTP directo a Envoy en el puerto 8000) ---
SUPABASE_PUBLIC_URL=http://supabase.lab.internal:8000
API_EXTERNAL_URL=http://supabase.lab.internal:8000/auth/v1

# --- URLs, fase 2 (HTTPS con Caddy en el 443): reemplazar las dos de arriba ---
# SUPABASE_PUBLIC_URL=https://supabase.lab.internal
# API_EXTERNAL_URL=https://supabase.lab.internal/auth/v1

# Aplicación cliente a la que Auth redirige después de un login
SITE_URL=http://cliente.lab.internal:3000

# Nombre que usa Caddy para el sitio y para elegir el certificado
PROXY_DOMAIN=supabase.lab.internal

# Tenant de Supavisor: el usuario SQL queda postgres.labredes
POOLER_TENANT_ID=labredes

STUDIO_DEFAULT_ORGANIZATION=UNLPam Lab Redes
STUDIO_DEFAULT_PROJECT=Prototipo Supabase

# Sin servidor SMTP en el laboratorio: las cuentas se confirman solas
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false

# Pasar a true cuando estén creados los usuarios de prueba
DISABLE_SIGNUP=false

# Sin asistente de IA en Studio
OPENAI_API_KEY=
